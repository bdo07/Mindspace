/* MINDSPACE Light Theme - Forest Green & Warm Amber Identity */

* {
    font-family: ".AppleSystemUIFont", "Segoe UI", Roboto, "Helvetica Neue", Inter, Arial;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F7F8F4;
    color: #20251E;
}

/* --------------------------------------------------------------------------
   SIDEBAR
   -------------------------------------------------------------------------- */
QWidget#sidebarContainer {
    background-color: #F0F2EB;
    border-right: 1px solid #E4E8DF;
}

QLabel#appTitle {
    font-size: 14px;
    font-weight: 700;
    color: #15370D;
    letter-spacing: 0.5px;
}

QLabel#appSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #777E73;
}

QLabel#sidebarSectionTitle {
    font-size: 10px;
    font-weight: 700;
    color: #8F978A;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    padding-left: 8px;
    padding-top: 12px;
    padding-bottom: 4px;
}

QPushButton.sidebarNavBtn {
    text-align: left;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    font-weight: 500;
    color: #3E463B;
}

QPushButton.sidebarNavBtn QLabel {
    color: #3E463B;
    background: transparent;
}

QPushButton.sidebarNavBtn:hover {
    background-color: #E6EADF;
    color: #15370D;
}

QPushButton.sidebarNavBtn:hover QLabel {
    color: #15370D;
}

QPushButton.sidebarNavBtn[active="true"] {
    background-color: #FFFFFF;
    color: #15370D;
    font-weight: 600;
    border: 1px solid #D8DED1;
}

QPushButton.sidebarNavBtn[active="true"] QLabel {
    color: #15370D;
    font-weight: 600;
}

/* Sidebar Count Badges */
QLabel.badge {
    background-color: #E2E7DB;
    color: #52594E;
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 600;
}

QLabel.badgeActive {
    background-color: #15370D;
    color: #FFFFFF;
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 700;
}

/* --------------------------------------------------------------------------
   MAIN CONTENT HEADER
   -------------------------------------------------------------------------- */
QWidget#mainContentArea {
    background-color: #F7F8F4;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #20251E;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #777E73;
}

/* --------------------------------------------------------------------------
   BUTTONS
   -------------------------------------------------------------------------- */
QPushButton.primaryBtn {
    background-color: #15370D;
    color: #FFFFFF;
    border: 1px solid #0F2709;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton.primaryBtn:hover {
    background-color: #1D4D13;
    border-color: #15370D;
}

QPushButton.primaryBtn:pressed {
    background-color: #0A1B06;
}

QPushButton.primaryBtn:disabled {
    background-color: #9FB29A;
    border-color: #9FB29A;
    color: #F7F8F4;
}

QPushButton.secondaryBtn {
    background-color: #FFFFFF;
    color: #20251E;
    border: 1px solid #E4E8DF;
    border-radius: 7px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.secondaryBtn:hover {
    background-color: #F0F2EB;
    border-color: #D2D8CB;
    color: #15370D;
}

QPushButton.secondaryBtn:pressed {
    background-color: #E6EADF;
}

QPushButton.secondaryBtn[active="true"] {
    background-color: #E8F0E4;
    border-color: #15370D;
    color: #15370D;
    font-weight: 600;
}

QPushButton.iconBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

QPushButton.iconBtn:hover {
    background-color: #EAEFE5;
    border-color: #D8E0D2;
}

QPushButton.iconBtn[active="true"] {
    background-color: #E8F0E4;
    border-color: #C3D5BC;
}

QPushButton.dangerBtn {
    background-color: #FFFFFF;
    color: #D63031;
    border: 1px solid #FFC9C9;
    border-radius: 7px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.dangerBtn:hover {
    background-color: #FFF5F5;
    border-color: #FF8787;
}

/* --------------------------------------------------------------------------
   INPUTS & CONTROLS
   -------------------------------------------------------------------------- */
QLineEdit.searchInput {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 7px;
    padding: 6px 12px 6px 30px;
    font-size: 13px;
    color: #20251E;
}

QLineEdit.searchInput:focus {
    border: 1.5px solid #15370D;
    background-color: #FFFFFF;
}

QLineEdit.standardInput, QTextEdit.standardInput, QPlainTextEdit.standardInput, QComboBox, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 7px;
    padding: 7px 11px;
    font-size: 13px;
    color: #20251E;
    selection-background-color: #E8F0E4;
    selection-color: #15370D;
}

QLineEdit.standardInput:focus, QTextEdit.standardInput:focus, QPlainTextEdit.standardInput:focus, QComboBox:focus, QDateEdit:focus {
    border: 1.5px solid #15370D;
}

QLineEdit[hasError="true"], QTextEdit[hasError="true"], QPlainTextEdit[hasError="true"] {
    border: 1.5px solid #D63031;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 6px;
    selection-background-color: #E8F0E4;
    selection-color: #15370D;
    color: #20251E;
    padding: 4px;
}

/* --------------------------------------------------------------------------
   MENUS & POPUPS
   -------------------------------------------------------------------------- */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
    padding: 4px;
    color: #20251E;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 16px 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    color: #20251E;
}

QMenu::item:selected {
    background-color: #E8F0E4;
    color: #15370D;
}

QMenu::separator {
    height: 1px;
    background-color: #E4E8DF;
    margin: 4px 8px;
}

/* --------------------------------------------------------------------------
   CARDS (Notes & Tasks)
   -------------------------------------------------------------------------- */
QFrame.noteCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 10px;
}

QFrame.noteCard:hover {
    border-color: #C8CEC1;
    background-color: #FDFEFB;
}

QFrame.noteCardPinned {
    background-color: #FFFFFF;
    border: 1.5px solid #C4D7BC;
    border-radius: 10px;
}

QFrame.noteCardPinned:hover {
    border-color: #15370D;
    background-color: #FAFDF8;
}

QLabel.cardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #20251E;
}

QLabel.cardPreview {
    font-size: 12px;
    line-height: 1.45;
    color: #777E73;
}

QLabel.cardDate {
    font-size: 11px;
    color: #9AA295;
    font-weight: 500;
}

/* --------------------------------------------------------------------------
   QUICK NOTES VIEW
   -------------------------------------------------------------------------- */
QPlainTextEdit#quickCaptureInput {
    border: none;
    background: transparent;
    font-size: 14px;
    line-height: 1.5;
    color: #20251E;
    padding: 0;
}

QLabel.quickThoughtContent {
    font-size: 13px;
    color: #20251E;
    line-height: 1.5;
}

QLabel.hintText {
    font-size: 11px;
    color: #777E73;
}

/* --------------------------------------------------------------------------
   EDITOR
   -------------------------------------------------------------------------- */
QLineEdit#editorTitleInput {
    background: transparent;
    border: none;
    font-size: 24px;
    font-weight: 700;
    color: #20251E;
    padding: 2px 0px;
}

QPlainTextEdit#editorContentInput, QTextEdit#editorContentInput {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: #20251E;
}

QPlainTextEdit#editorContentInput:focus, QTextEdit#editorContentInput:focus {
    border-color: #15370D;
}

QTextBrowser#markdownPreview {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
}

QFrame#editorToolbar {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 7px;
    padding: 2px 4px;
}

QLabel.editorStatusText {
    font-size: 11px;
    font-weight: 500;
    color: #777E73;
}

QSplitter::handle:horizontal {
    background-color: transparent;
    width: 6px;
}

/* --------------------------------------------------------------------------
   TASKS
   -------------------------------------------------------------------------- */
QFrame.taskItem {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
    padding: 8px 12px;
}

QFrame.taskItem:hover {
    border-color: #C8CEC1;
}

QFrame.taskItemCompleted {
    background-color: #F3F5EE;
    border: 1px solid #E0E5DA;
    border-radius: 8px;
}

QLabel.taskTitle {
    font-size: 13px;
    font-weight: 500;
    color: #20251E;
}

QLabel.taskTitleCompleted {
    font-size: 13px;
    font-weight: 400;
    color: #9AA295;
    text-decoration: line-through;
}

/* Priority Badges */
QLabel.prioBadgeHigh {
    background-color: #FFE3E3;
    color: #D63031;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

/* Due Badges */
QLabel.dueBadge {
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 600;
}

QLabel.dueBadge_overdue {
    background-color: #FFE3E3;
    color: #D63031;
}

QLabel.dueBadge_today {
    background-color: #FEF3E2;
    color: #C87A1E;
}

QLabel.dueBadge_tomorrow {
    background-color: #EEF8FF;
    color: #0284C7;
}

QLabel.dueBadge_upcoming {
    background-color: #EFF2EB;
    color: #626A5D;
}

/* Section Subheader in Tasks / Settings */
QLabel.sectionHeader {
    font-size: 11px;
    font-weight: 700;
    color: #777E73;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-top: 10px;
}

/* Warm Amber Progress Indicator */
QLabel.taskProgressLabel {
    font-size: 11px;
    font-weight: 700;
    color: #C87A1E;
}

/* Segmented Tabs */
QPushButton.segmentedTab {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    color: #777E73;
}

QPushButton.segmentedTab:hover {
    color: #20251E;
}

QPushButton.segmentedTab[active="true"] {
    background-color: #FFFFFF;
    color: #15370D;
    font-weight: 600;
    border: 1px solid #D8DED1;
}

/* --------------------------------------------------------------------------
   SETTINGS VIEW
   -------------------------------------------------------------------------- */
QLabel.settingTitle {
    font-size: 13px;
    font-weight: 600;
    color: #20251E;
}

QLabel.settingDesc {
    font-size: 12px;
    color: #777E73;
}

QLabel.statsText {
    font-size: 12px;
    color: #777E73;
    line-height: 1.6;
}

/* --------------------------------------------------------------------------
   CHECKBOXES & RADIO BUTTONS
   -------------------------------------------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 8px;
    font-size: 13px;
    color: #20251E;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #C8CEC1;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #15370D;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #15370D;
    border-color: #15370D;
}

/* --------------------------------------------------------------------------
   SCROLLBARS
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #D5DBD0;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #BAC2B4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #D5DBD0;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --------------------------------------------------------------------------
   TOOLTIPS
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #20251E;
    color: #F7F8F4;
    border: 1px solid #3E463B;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   DIALOGS & MODALS
   -------------------------------------------------------------------------- */
QDialog, QMessageBox {
    background-color: #FFFFFF;
    color: #20251E;
    border: 1px solid #E4E8DF;
    border-radius: 12px;
}

QMessageBox QLabel {
    color: #20251E;
    font-size: 13px;
}

QLabel.dialogTitle {
    font-size: 16px;
    font-weight: 700;
    color: #20251E;
    letter-spacing: -0.2px;
}

QLabel.dialogSubtitle, QLabel.inputLabel {
    font-size: 11px;
    font-weight: 600;
    color: #777E73;
}

QLabel.dialogDesc {
    font-size: 13px;
    color: #777E73;
    line-height: 1.45;
}

QLabel.dialogError {
    color: #D63031;
    font-size: 11px;
    font-weight: 600;
}

QLabel.aboutTitle {
    font-size: 20px;
    font-weight: 700;
    color: #15370D;
    letter-spacing: 0.5px;
}

QLabel.aboutVersion {
    font-size: 12px;
    font-weight: 500;
    color: #777E73;
}

QFrame.shortcutCard {
    background-color: #F7F8F4;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
    padding: 10px;
}

QLabel.shortcutKey {
    font-size: 11px;
    font-weight: 700;
    color: #15370D;
}

QLabel.shortcutDesc {
    font-size: 11px;
    color: #20251E;
}

/* --------------------------------------------------------------------------
   CALENDAR WIDGET (Popups & Date Pickers)
   -------------------------------------------------------------------------- */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E8DF;
    border-radius: 8px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F7F8F4;
    border-bottom: 1px solid #E4E8DF;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #20251E;
    font-size: 12px;
    font-weight: 600;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #E8F0E4;
    color: #15370D;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    width: 24px;
    height: 24px;
}

QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #20251E;
    border: 1px solid #E4E8DF;
    border-radius: 4px;
    padding: 2px 4px;
}

QCalendarWidget QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FFFFFF;
    color: #20251E;
    selection-background-color: #15370D;
    selection-color: #FFFFFF;
    border: none;
    outline: none;
}

QCalendarWidget QTableView:enabled {
    color: #20251E;
}

QCalendarWidget QTableView:disabled {
    color: #B5BDB0;
}

QCalendarWidget QHeaderView::section {
    background-color: #FFFFFF;
    color: #777E73;
    border: none;
    font-size: 11px;
    font-weight: 600;
    padding: 4px;
}
