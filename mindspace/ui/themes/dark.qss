/* MINDSPACE Dark Theme - Forest Green & Sky Blue Luxury Identity */

* {
    font-family: ".AppleSystemUIFont", "Segoe UI", Roboto, "Helvetica Neue", Inter, Arial;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #11170F;
    color: #F2F5ED;
}

/* --------------------------------------------------------------------------
   SIDEBAR
   -------------------------------------------------------------------------- */
QWidget#sidebarContainer {
    background-color: #182116;
    border-right: 1px solid #354331;
}

QLabel#appTitle {
    font-size: 14px;
    font-weight: 700;
    color: #F2F5ED;
    letter-spacing: 0.5px;
}

QLabel#appSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #8F9E87;
}

QLabel#sidebarSectionTitle {
    font-size: 10px;
    font-weight: 700;
    color: #6C7865;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    padding-left: 8px;
    padding-top: 12px;
    padding-bottom: 4px;
}

QPushButton.sidebarNavBtn {
    text-align: left;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    font-weight: 500;
    color: #A7B29F;
}

QPushButton.sidebarNavBtn QLabel {
    color: #A7B29F;
    background: transparent;
}

QPushButton.sidebarNavBtn:hover {
    background-color: #202B1D;
    color: #F2F5ED;
}

QPushButton.sidebarNavBtn:hover QLabel {
    color: #F2F5ED;
}

QPushButton.sidebarNavBtn[active="true"] {
    background-color: #293725;
    color: #F2F5ED;
    font-weight: 600;
    border: 1px solid #43543E;
}

QPushButton.sidebarNavBtn[active="true"] QLabel {
    color: #F2F5ED;
    font-weight: 600;
}

/* Sidebar Count Badges */
QLabel.badge {
    background-color: #243021;
    color: #A7B29F;
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 600;
}

QLabel.badgeActive {
    background-color: #97D7FF;
    color: #11170F;
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 700;
}

/* --------------------------------------------------------------------------
   MAIN CONTENT HEADER
   -------------------------------------------------------------------------- */
QWidget#mainContentArea {
    background-color: #11170F;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #F2F5ED;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #A7B29F;
}

/* --------------------------------------------------------------------------
   BUTTONS
   -------------------------------------------------------------------------- */
QPushButton.primaryBtn {
    background-color: #97D7FF;
    color: #11170F;
    border: 1px solid #B5E3FF;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton.primaryBtn:hover {
    background-color: #B5E3FF;
    border-color: #D2F0FF;
}

QPushButton.primaryBtn:pressed {
    background-color: #7AC7F5;
}

QPushButton.primaryBtn:disabled {
    background-color: #2B424F;
    border-color: #2B424F;
    color: #5D798A;
}

QPushButton.secondaryBtn {
    background-color: #202B1D;
    color: #F2F5ED;
    border: 1px solid #354331;
    border-radius: 7px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.secondaryBtn:hover {
    background-color: #293725;
    border-color: #495B44;
    color: #97D7FF;
}

QPushButton.secondaryBtn:pressed {
    background-color: #32432D;
}

QPushButton.secondaryBtn[active="true"] {
    background-color: #1E3545;
    border-color: #97D7FF;
    color: #97D7FF;
    font-weight: 600;
}

QPushButton.iconBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

QPushButton.iconBtn:hover {
    background-color: #293725;
    border-color: #3F503A;
}

QPushButton.iconBtn[active="true"] {
    background-color: #1E3545;
    border-color: #385E77;
}

QPushButton.dangerBtn {
    background-color: #2A1A1A;
    color: #FF6B6B;
    border: 1px solid #4D2626;
    border-radius: 7px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.dangerBtn:hover {
    background-color: #382020;
    border-color: #6C3333;
}

/* --------------------------------------------------------------------------
   INPUTS & CONTROLS
   -------------------------------------------------------------------------- */
QLineEdit.searchInput {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 7px;
    padding: 6px 12px 6px 30px;
    font-size: 13px;
    color: #F2F5ED;
}

QLineEdit.searchInput:focus {
    border: 1.5px solid #97D7FF;
    background-color: #253322;
}

QLineEdit.standardInput, QTextEdit.standardInput, QPlainTextEdit.standardInput, QComboBox, QDateEdit {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 7px;
    padding: 7px 11px;
    font-size: 13px;
    color: #F2F5ED;
    selection-background-color: #1E3545;
    selection-color: #97D7FF;
}

QLineEdit.standardInput:focus, QTextEdit.standardInput:focus, QPlainTextEdit.standardInput:focus, QComboBox:focus, QDateEdit:focus {
    border: 1.5px solid #97D7FF;
}

QLineEdit[hasError="true"], QTextEdit[hasError="true"], QPlainTextEdit[hasError="true"] {
    border: 1.5px solid #FF6B6B;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 6px;
    selection-background-color: #1E3545;
    selection-color: #97D7FF;
    color: #F2F5ED;
    padding: 4px;
}

/* --------------------------------------------------------------------------
   MENUS & POPUPS
   -------------------------------------------------------------------------- */
QMenu {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 8px;
    padding: 4px;
    color: #F2F5ED;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 16px 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    color: #F2F5ED;
}

QMenu::item:selected {
    background-color: #293725;
    color: #97D7FF;
}

QMenu::separator {
    height: 1px;
    background-color: #354331;
    margin: 4px 8px;
}

/* --------------------------------------------------------------------------
   CARDS (Notes & Tasks)
   -------------------------------------------------------------------------- */
QFrame.noteCard {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 10px;
}

QFrame.noteCard:hover {
    border-color: #4D6047;
    background-color: #253322;
}

QFrame.noteCardPinned {
    background-color: #223020;
    border: 1.5px solid #435A3D;
    border-radius: 10px;
}

QFrame.noteCardPinned:hover {
    border-color: #6C9B59;
    background-color: #263723;
}

QLabel.cardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #F2F5ED;
}

QLabel.cardPreview {
    font-size: 12px;
    line-height: 1.45;
    color: #A7B29F;
}

QLabel.cardDate {
    font-size: 11px;
    color: #7E8C76;
    font-weight: 500;
}

/* --------------------------------------------------------------------------
   QUICK NOTES VIEW
   -------------------------------------------------------------------------- */
QPlainTextEdit#quickCaptureInput {
    border: none;
    background: transparent;
    font-size: 14px;
    line-height: 1.5;
    color: #F2F5ED;
    padding: 0;
}

QLabel.quickThoughtContent {
    font-size: 13px;
    color: #F2F5ED;
    line-height: 1.5;
}

QLabel.hintText {
    font-size: 11px;
    color: #7E8C76;
}

/* --------------------------------------------------------------------------
   EDITOR
   -------------------------------------------------------------------------- */
QLineEdit#editorTitleInput {
    background: transparent;
    border: none;
    font-size: 24px;
    font-weight: 700;
    color: #F2F5ED;
    padding: 2px 0px;
}

QPlainTextEdit#editorContentInput, QTextEdit#editorContentInput {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 8px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: #F2F5ED;
}

QPlainTextEdit#editorContentInput:focus, QTextEdit#editorContentInput:focus {
    border-color: #4D6047;
}

QTextBrowser#markdownPreview {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 8px;
}

QFrame#editorToolbar {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 7px;
    padding: 2px 4px;
}

QLabel.editorStatusText {
    font-size: 11px;
    font-weight: 500;
    color: #8F9E87;
}

QSplitter::handle:horizontal {
    background-color: transparent;
    width: 6px;
}

/* --------------------------------------------------------------------------
   TASKS
   -------------------------------------------------------------------------- */
QFrame.taskItem {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 8px;
    padding: 8px 12px;
}

QFrame.taskItem:hover {
    border-color: #4D6047;
}

QFrame.taskItemCompleted {
    background-color: #192217;
    border: 1px solid #283424;
    border-radius: 8px;
}

QLabel.taskTitle {
    font-size: 13px;
    font-weight: 500;
    color: #F2F5ED;
}

QLabel.taskTitleCompleted {
    font-size: 13px;
    font-weight: 400;
    color: #6C7865;
    text-decoration: line-through;
}

/* Priority Badges */
QLabel.prioBadgeHigh {
    background-color: #401B1B;
    color: #FF8787;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

/* Due Badges */
QLabel.dueBadge {
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 600;
}

QLabel.dueBadge_overdue {
    background-color: #401B1B;
    color: #FF8787;
}

QLabel.dueBadge_today {
    background-color: #382713;
    color: #F1A344;
}

QLabel.dueBadge_tomorrow {
    background-color: #152A38;
    color: #97D7FF;
}

QLabel.dueBadge_upcoming {
    background-color: #253322;
    color: #B2BEAB;
}

/* Section Subheader in Tasks / Settings */
QLabel.sectionHeader {
    font-size: 11px;
    font-weight: 700;
    color: #7E8C76;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-top: 10px;
}

/* Warm Amber Progress Indicator */
QLabel.taskProgressLabel {
    font-size: 11px;
    font-weight: 700;
    color: #F1A344;
}

/* Segmented Tabs */
QPushButton.segmentedTab {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    color: #8F9E87;
}

QPushButton.segmentedTab:hover {
    color: #F2F5ED;
}

QPushButton.segmentedTab[active="true"] {
    background-color: #293725;
    color: #F2F5ED;
    font-weight: 600;
    border: 1px solid #43543E;
}

/* --------------------------------------------------------------------------
   SETTINGS VIEW
   -------------------------------------------------------------------------- */
QLabel.settingTitle {
    font-size: 13px;
    font-weight: 600;
    color: #F2F5ED;
}

QLabel.settingDesc {
    font-size: 12px;
    color: #A7B29F;
}

QLabel.statsText {
    font-size: 12px;
    color: #A7B29F;
    line-height: 1.6;
}

/* --------------------------------------------------------------------------
   CHECKBOXES & RADIO BUTTONS
   -------------------------------------------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 8px;
    font-size: 13px;
    color: #F2F5ED;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #43543E;
    border-radius: 4px;
    background-color: #202B1D;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #97D7FF;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #6C9B59;
    border-color: #6C9B59;
}

/* --------------------------------------------------------------------------
   SCROLLBARS
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #354331;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #4D6047;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #354331;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --------------------------------------------------------------------------
   TOOLTIPS
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #293725;
    color: #F2F5ED;
    border: 1px solid #43543E;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   DIALOGS & MODALS
   -------------------------------------------------------------------------- */
QDialog, QMessageBox {
    background-color: #202B1D;
    color: #F2F5ED;
    border: 1px solid #354331;
    border-radius: 12px;
}

QMessageBox QLabel {
    color: #F2F5ED;
    font-size: 13px;
}

QLabel.dialogTitle {
    font-size: 16px;
    font-weight: 700;
    color: #F2F5ED;
    letter-spacing: -0.2px;
}

QLabel.dialogSubtitle, QLabel.inputLabel {
    font-size: 11px;
    font-weight: 600;
    color: #A7B29F;
}

QLabel.dialogDesc {
    font-size: 13px;
    color: #A7B29F;
    line-height: 1.45;
}

QLabel.dialogError {
    color: #FF6B6B;
    font-size: 11px;
    font-weight: 600;
}

QLabel.aboutTitle {
    font-size: 20px;
    font-weight: 700;
    color: #97D7FF;
    letter-spacing: 0.5px;
}

QLabel.aboutVersion {
    font-size: 12px;
    font-weight: 500;
    color: #A7B29F;
}

QFrame.shortcutCard {
    background-color: #182116;
    border: 1px solid #354331;
    border-radius: 8px;
    padding: 10px;
}

QLabel.shortcutKey {
    font-size: 11px;
    font-weight: 700;
    color: #97D7FF;
}

QLabel.shortcutDesc {
    font-size: 11px;
    color: #F2F5ED;
}

/* --------------------------------------------------------------------------
   CALENDAR WIDGET (Popups & Date Pickers)
   -------------------------------------------------------------------------- */
QCalendarWidget {
    background-color: #202B1D;
    border: 1px solid #354331;
    border-radius: 8px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #182116;
    border-bottom: 1px solid #354331;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #F2F5ED;
    font-size: 12px;
    font-weight: 600;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #293725;
    color: #97D7FF;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    width: 24px;
    height: 24px;
}

QCalendarWidget QSpinBox {
    background-color: #202B1D;
    color: #F2F5ED;
    border: 1px solid #354331;
    border-radius: 4px;
    padding: 2px 4px;
}

QCalendarWidget QTableView {
    background-color: #202B1D;
    alternate-background-color: #202B1D;
    color: #F2F5ED;
    selection-background-color: #293725;
    selection-color: #97D7FF;
    border: none;
    outline: none;
}

QCalendarWidget QTableView:enabled {
    color: #F2F5ED;
}

QCalendarWidget QTableView:disabled {
    color: #556650;
}

QCalendarWidget QHeaderView::section {
    background-color: #202B1D;
    color: #A7B29F;
    border: none;
    font-size: 11px;
    font-weight: 600;
    padding: 4px;
}
